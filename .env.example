# Public site URL used in email links (no trailing slash).
SITE_URL=http://localhost:3000

# Supabase (server-only service role — never expose to the browser).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend
RESEND_API_KEY=
EMAIL_FROM="Marque & Manners <newsletter@yourdomain.com>"

# Temporary stopgap: set to "true" while you don't have a verified Resend
# sending domain, so signups auto-confirm instead of emailing a (currently
# undeliverable) confirmation link to arbitrary visitor addresses. Remove
# this once a domain is verified, to restore real double opt-in.
AUTO_CONFIRM_SUBSCRIBERS=

# Admin auth
# Generate a hash with: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_PASSWORD_HASH=
# Generate a random secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
